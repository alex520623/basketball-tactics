# Local Python environments, interpreters, and caches
.venv/
venv/
env/
.tools/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Credentials: store real values locally, never in source code
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets/
secrets.*

# Dataset contents and generated outputs are local; keep documentation only
/data/*
!/data/README.md
!/data/raw/
!/data/processed/
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/outputs/*
!/outputs/.gitkeep
/logs/
*.log
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.zip
*.7z
*.tar
*.gz
*.mp4
*.mov
*.avi
*.pt
*.pth
*.onnx

# OS/editor local state
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.code-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
